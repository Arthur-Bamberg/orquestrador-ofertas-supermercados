# Copie para `.env` na raiz (gitignored).
# `docker compose` interpola POSTGRES_* e passa o resto aos serviços via env_file.
# DATABASE_URL abaixo é para o host (psql, go run). Nos contentores o Compose
# aponta ao hostname `postgres`. Listen HTTP é definido por serviço no Compose.

POSTGRES_USER=ofertas
POSTGRES_PASSWORD=ofertas
POSTGRES_DB=ofertas

DATABASE_URL=postgres://ofertas:ofertas@localhost:5432/ofertas?sslmode=disable
TZ=America/Sao_Paulo
CORS_ORIGIN=http://localhost:5173
# SPA (host `npm run dev` e Compose): origens relativas via proxy. Não defina
# VITE_API_BASE/VITE_GATEWAY_BASE para o browser falar direto com :8080/:8090 —
# o cookie do Operador não atravessa a porta (ADR 0018).
# VITE_API_BASE=
# VITE_GATEWAY_BASE=/gateway

# ofertas-scraper (Compose run e ops da API no contentor da API)
EXTRATOR_PROVIDER=auto
EXTRATOR_STUB=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Agente também usa GEMINI_* para o Termo de cada Item (sem chave = só invólucro).
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
EXTRATOR_PROMPT_PATH=./prompts/extrator.txt
EXTRACAO_SCHEMA_PATH=./schemas/extracao.json
OFERTA_SCHEMA_PATH=./schemas/oferta.json
SEED_PATH=./seed/fontes.json
RASTER_MAX_EDGE_PX=1280
RASTER_JPEG_QUALITY=80

# gateway-whatsapp
GATEWAY_TOKEN=dev-token-change-me
# Segredo entre processos (Lista, Coleta, envio da Resposta). Não vai no SPA.
# Operador do backoffice: inserir no Postgres (sem UI). Hash bcrypt da senha:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
#   INSERT INTO backoffice.operador (id, nome, senha_hash)
#   VALUES (encode(gen_random_bytes(16), 'hex'), 'arthur', '$2a$10$...');
# Ack e POST /envios: JIDs de Conversa (E.164 e/ou 120363…@g.us / …-…@g.us). Persistência não usa esta lista.
# Ex.: grupo "Teste" → 120363430294212306@g.us
WHATSAPP_ALLOWLIST=5511999999999
WHATSAPP_ACK_TEXTO=Recebi. O ajudante de ofertas ainda não está ligado neste canal.
# 1 = canal stub (sem QR). 0 = whatsmeow real: QR na tela Canal do backoffice (e nos logs).
WHATSAPP_STUB=0
WHATSAPP_SESSION_PATH=./.data/whatsmeow.db
MIDIA_ROOT=./.data/midia
# Agente (Compose: gateway usa AGENTE_URL interno). Vazio no host = Ack estático.
# AGENTE_URL=http://localhost:8091
GATEWAY_URL=http://localhost:8090
# Coleta de vitrine (Compose: ofertas-scraper-v2 :8092). Host: go run no app.
# API e Agente usam COLETA_URL para testar scraping / disparar Coleta.
COLETA_URL=http://localhost:8092
