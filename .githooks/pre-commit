#!/usr/bin/env bash
# Runs workspace tests before allowing a commit (Go modules + ofertas-backoffice).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ ! -f go.work ]]; then
  echo "pre-commit: go.work missing at repo root" >&2
  exit 1
fi

echo "pre-commit: testing workspace modules"
while IFS= read -r dir; do
  echo "pre-commit: go test ./... (in ${dir#"$root"/})"
  (cd "$dir" && go test ./...)
done < <(go list -f '{{.Dir}}' -m)

backoffice="$root/apps/ofertas-backoffice"
if [[ -f "$backoffice/package.json" ]]; then
  echo "pre-commit: npm test (apps/ofertas-backoffice)"
  (cd "$backoffice" && npm test)
fi
