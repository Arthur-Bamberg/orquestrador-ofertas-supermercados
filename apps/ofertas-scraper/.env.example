# Copy to .env in this app directory (gitignored). Paths below are relative to apps/ofertas-scraper.
# Start Postgres from the monorepo root: docker compose up
DATABASE_URL=postgres://ofertas:ofertas@localhost:5432/ofertas?sslmode=disable
# One-shot data copy (optional): keep UPSTASH_* only while running migrate-from-redis
# UPSTASH_REDIS_REST_URL=http://localhost:8079
# UPSTASH_REDIS_REST_TOKEN=local_dev_token
# Extrator: set EXTRATOR_STUB=0 and at least one provider key.
# EXTRATOR_PROVIDER=auto|cursor|gemini (empty=auto; auto = Gemini first, Cursor on rate-limit — ADR 0037)
EXTRATOR_PROVIDER=auto
EXTRATOR_STUB=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# CURSOR_PYTHON=python3
EXTRATOR_PROMPT_PATH=./prompts/extrator.txt
EXTRACAO_SCHEMA_PATH=./schemas/extracao.json
OFERTA_SCHEMA_PATH=./schemas/oferta.json
SEED_PATH=./seed/fontes.json
ARTEFATO_ROOT=./.data/artefatos
RASTER_MAX_EDGE_PX=1280
RASTER_JPEG_QUALITY=80
TZ=America/Sao_Paulo
# Optional smoke limits (empty = process all):
# RUN_FONTE_ID=fonte-fort
# RUN_MAX_DOCUMENTOS=1
